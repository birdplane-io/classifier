# LLM Configuration (LiteLLM)
# Required
LLM_API_KEY=sk-your-key-here

# Model to use (supports any LLM provider via LiteLLM)
# Examples: gpt-4-turbo, gpt-3.5-turbo, claude-3-opus, claude-3-sonnet
LLM_MODEL=gpt-4-turbo

# Optional: Custom endpoint URL
# Leave blank to use provider's default endpoint
# Examples:
#   - Local LiteLLM proxy: http://localhost:4000
#   - Local Ollama: http://localhost:11434
#   - Custom OpenAI-compatible server: https://api.custom.com/v1
LLM_BASE_URL=

# Provider (inferred from model if using standard naming)
# Examples: openai, anthropic, local
LLM_PROVIDER=openai

# Temperature for model responses (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# Maximum tokens in response
LLM_MAX_TOKENS=4000

# Classifier Selection (llm or embedding)
CLASSIFIER_TYPE=llm
