# The only implemented backend is the LiteLLM-backed classifier.
CLASSIFIER_BACKEND=llm

# OpenAI-compatible LiteLLM gateway credentials.
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=replace-me

# Optional classifier deployment name and request timeout (seconds).
LLM_MODEL=document-classifier
LLM_TIMEOUT=30
